                  data-autoid="dds--tableofcontents__desktop"
                >
                  <ul />
                </div>
              </TOCDesktop>
              <TOCMobile
                menuItems={
                  Array [
                    Object {
                      "id": "menuLabel",
                      "title": "Jump to ...",
                    },
                  ]
                }
                menuLabel="Jump to"
                selectedId=""
                selectedTitle=""
                updateState={[Function]}
