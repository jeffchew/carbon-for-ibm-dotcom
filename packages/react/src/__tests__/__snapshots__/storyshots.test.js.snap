  story={[Function]}
>
  <div
    className=""
    data-floating-menu-container=""
    role="main"
  >
    <style />
    <TableOfContents
      headingContent={false}
      menuItems={null}
      menuLabel="Jump to"
      menuRule={true}
      stickyOffset={null}
      theme="white"
    >
      <section
        className="bx--tableofcontents bx--tableofcontents--white"
        data-autoid="dds--tableofcontents"
      >
        <div
          className="dds-ce--table-of-contents__container"
        >
          <div
            className="bx--tableofcontents__sidebar"
          >
            <div
              className="bx--tableofcontents__mobile-top"
            />
            <div
              style={
                Object {
                  "position": "sticky",
                  "top": 0,
                }
              }
            >
              <TOCDesktop
                headingContent={false}
                menuItems={
                  Array [
                    Object {
                      "id": "menuLabel",
                      "title": "Jump to ...",
