                              </Icon>
                            </ForwardRef(ArrowRight20)>
                          </a>
                        </Link>
                      </div>
                    </LinkWithIcon>
                  </TextCTA>
                </div>
              </CTA>
            </div>
            <div
              className="bx--content-section__children bx--col-lg-8"
            />
          </div>
        </div>
      </section>
    </ContentSection>
  </div>
  <input
    aria-label="input-text-offleft"
    className="bx--visually-hidden"
    type="text"
  />
</Container>
`;

